# Supabase Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# Backend API base URL. Defaults to /api (proxied) in production and dev.
VITE_API_URL=

# Optional shared secret that the backend expects as "Authorization: Bearer <token>".
# Must match the API_TOKEN set on the backend (Render). Leave empty for local dev without auth.
VITE_API_TOKEN=

