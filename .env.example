# Choose groq (default) or openai
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./data/reviews.db
# Optional shared secret for API access. The frontend sends it as "Authorization: Bearer <token>".
# Leave empty to disable auth (local development). Set it in production to block strangers from using your AI credits.
API_TOKEN=
# Comma-separated list of allowed origins, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

