# Supabase Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# Backend API base URL. Defaults to http://localhost:8000/api in development.
# For Vercel, keep it unset (the /api rewrite proxies to Render) or point it at your Render service.
VITE_API_URL=

